<Window x:Class="QuantaRAM.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:QuantaRAM.UI"
        Title="Quanta · Memory Core" Width="1320" Height="830" MinWidth="1140" MinHeight="740"
        WindowStartupLocation="CenterScreen" Background="{StaticResource B.Bg0}"
        FontFamily="Bahnschrift" Foreground="{StaticResource B.Text}" Icon="Assets/quanta.ico"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root">
        <!-- ================= background ================= -->
        <Grid IsHitTestVisible="False">
            <!-- static layers are rasterized once (BitmapCache) and then just blitted -->
            <Grid CacheMode="BitmapCache">
            <Rectangle>
                <Rectangle.Fill>
                    <RadialGradientBrush Center="0.5,0.35" GradientOrigin="0.5,0.35" RadiusX="0.8" RadiusY="0.9">
                        <GradientStop Color="#FF0B1630" Offset="0"/>
                        <GradientStop Color="#FF060A16" Offset="0.55"/>
                        <GradientStop Color="#FF03050A" Offset="1"/>
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle Fill="{StaticResource B.GridTile}" Opacity="0.8"/>
            <Rectangle>
                <Rectangle.Fill>
                    <RadialGradientBrush RadiusX="0.75" RadiusY="0.75">
                        <GradientStop Color="#00000000" Offset="0.6"/>
                        <GradientStop Color="#B0000000" Offset="1"/>
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            </Grid>
            <Ellipse x:Name="Nebula1" CacheMode="BitmapCache" Width="900" Height="600" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-250,-260,0,0" Fill="{StaticResource B.GlowCyan}" Opacity="0.35" RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform><TranslateTransform/></Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse x:Name="Nebula2" CacheMode="BitmapCache" Width="900" Height="700" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-300,-300" Fill="{StaticResource B.GlowMagenta}" Opacity="0.35">
                <Ellipse.RenderTransform><TranslateTransform/></Ellipse.RenderTransform>
            </Ellipse>
            <ui:ParticleField x:Name="Particles"/>
            <Rectangle x:Name="ScanLine" Height="180" VerticalAlignment="Top" CacheMode="BitmapCache">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#0000E5FF" Offset="0"/>
                        <GradientStop Color="#0C00E5FF" Offset="0.85"/>
                        <GradientStop Color="#3000E5FF" Offset="0.99"/>
                        <GradientStop Color="#0000E5FF" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
                <Rectangle.RenderTransform><TranslateTransform x:Name="ScanT" Y="-200"/></Rectangle.RenderTransform>
            </Rectangle>
        </Grid>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="28"/>
            </Grid.RowDefinitions>

            <!-- ================= title bar ================= -->
            <Grid Grid.Row="0">
                <Border Background="#99050912" BorderBrush="{StaticResource B.Stroke}" BorderThickness="0,0,0,1"/>
                <Rectangle Height="1" VerticalAlignment="Bottom" Fill="{StaticResource B.Accent}" Opacity="0.5" RenderTransformOrigin="0.5,0.5">
                    <Rectangle.RenderTransform><ScaleTransform x:Name="TitleLineS" ScaleX="0.3"/></Rectangle.RenderTransform>
                </Rectangle>
                <StackPanel Orientation="Horizontal" Margin="22,0,0,0" VerticalAlignment="Center">
                    <Grid Width="26" Height="26">
                        <Path Data="{StaticResource G.Hex}" Stroke="{StaticResource B.Cyan}" StrokeThickness="1.6" Stretch="Uniform" RenderTransformOrigin="0.5,0.5">
                            <Path.RenderTransform><RotateTransform x:Name="LogoRot"/></Path.RenderTransform>
                        </Path>
                        <Path Data="{StaticResource G.Hex}" Stroke="{StaticResource B.Magenta}" StrokeThickness="1.4" Stretch="Uniform" Margin="6" RenderTransformOrigin="0.5,0.5">
                            <Path.RenderTransform><RotateTransform x:Name="LogoRot2"/></Path.RenderTransform>
                        </Path>
                        <Ellipse x:Name="LogoDot" Width="4" Height="4" Fill="White"/>
                    </Grid>
                    <TextBlock Text="QUANTA" FontFamily="Bahnschrift SemiBold" FontSize="17" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock Text="//  MEMORY CORE" FontSize="12" Foreground="{StaticResource B.Muted}" Margin="10,1,0,0" VerticalAlignment="Center"/>
                    <Border CornerRadius="3" BorderBrush="#4400E5FF" BorderThickness="1" Padding="6,1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="VersionText" Text="v1.0" FontSize="10" Foreground="{StaticResource B.Cyan}"/>
                    </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="UpdateChip" Visibility="Collapsed" Cursor="Hand" Margin="0,0,10,0" VerticalAlignment="Center"
                            WindowChrome.IsHitTestVisibleInChrome="True" Click="UpdateChip_Click" ToolTip="A new version is available. Click for details">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" CornerRadius="10" Padding="10,3" BorderThickness="1" BorderBrush="#88FF2BD6" Background="#22FF2BD6">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M12,4L4,12H9V20H15V12H20L12,4Z" Fill="{StaticResource B.Magenta}" Width="10" Height="10" Stretch="Uniform" Margin="0,0,7,0"/>
                                        <ContentPresenter TextElement.FontSize="10.5" TextElement.FontFamily="Bahnschrift SemiBold" TextElement.Foreground="{StaticResource B.Magenta}"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#44FF2BD6"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Border x:Name="AdminChip" CornerRadius="10" Padding="10,3" Margin="0,0,10,0" VerticalAlignment="Center" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="AdminDot" Width="6" Height="6" Margin="0,0,7,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="AdminText" FontSize="10.5" FontFamily="Bahnschrift SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Button x:Name="ElevateBtn" Style="{StaticResource Ghost}" Content="ELEVATE" Padding="12,4" Margin="0,0,14,0" VerticalAlignment="Center"
                            WindowChrome.IsHitTestVisibleInChrome="True" Click="Elevate_Click" ToolTip="Restart with administrator rights to unlock standby / file-cache purges"/>
                    <Button Style="{StaticResource WinBtn}" Tag="{StaticResource G.Min}" WindowChrome.IsHitTestVisibleInChrome="True" Click="Min_Click"/>
                    <Button Style="{StaticResource WinBtn}" Tag="{StaticResource G.Max}" WindowChrome.IsHitTestVisibleInChrome="True" Click="Max_Click"/>
                    <Button Style="{StaticResource WinClose}" Tag="{StaticResource G.Close}" WindowChrome.IsHitTestVisibleInChrome="True" Click="Close_Click"/>
                </StackPanel>
            </Grid>

            <!-- ================= body ================= -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="76"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- nav rail -->
                <Border Background="#80050912" BorderBrush="{StaticResource B.Stroke}" BorderThickness="0,0,1,0"/>
                <Grid Margin="0,18,0,16">
                    <Rectangle x:Name="NavIndicator" Width="3" Height="34" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="{StaticResource B.AccentV}" RadiusX="1.5" RadiusY="1.5">
                        <Rectangle.RenderTransform><TranslateTransform x:Name="NavIndT" Y="10"/></Rectangle.RenderTransform>
                    </Rectangle>
                    <StackPanel HorizontalAlignment="Center">
                        <RadioButton x:Name="NavDash" Style="{StaticResource NavBtn}" Tag="{StaticResource G.Dash}" IsChecked="True" Checked="Nav_Checked" ToolTip="Dashboard"/>
                        <RadioButton x:Name="NavProc" Style="{StaticResource NavBtn}" Tag="{StaticResource G.Proc}" Checked="Nav_Checked" ToolTip="Process matrix"/>
                        <RadioButton x:Name="NavAuto" Style="{StaticResource NavBtn}" Tag="{StaticResource G.Bolt}" Checked="Nav_Checked" ToolTip="Automation"/>
                        <RadioButton x:Name="NavSet" Style="{StaticResource NavBtn}" Tag="{StaticResource G.Tune}" Checked="Nav_Checked" ToolTip="Settings"/>
                    </StackPanel>
                    <!-- mini load meter -->
                    <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center">
                        <Grid Width="6" Height="110" HorizontalAlignment="Center">
                            <Border CornerRadius="3" Background="#16FFFFFF"/>
                            <Border CornerRadius="3" Background="{StaticResource B.AccentV}" RenderTransformOrigin="0.5,1">
                                <Border.RenderTransform><ScaleTransform x:Name="MiniMeterS" ScaleY="0"/></Border.RenderTransform>
                            </Border>
                        </Grid>
                        <TextBlock x:Name="MiniMeterText" Text="0%" FontSize="11" HorizontalAlignment="Center" Margin="0,8,0,0" Foreground="{StaticResource B.Muted}"/>
                        <TextBlock Text="RAM" FontSize="9" HorizontalAlignment="Center" Foreground="{StaticResource B.Dim}"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Column="1" x:Name="Pages">
                    <!-- ================= DASHBOARD ================= -->
                    <Grid x:Name="PageDash" Margin="20,18,20,16">
                        <Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="300"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="196"/>
                        </Grid.RowDefinitions>

                        <!-- left column -->
                        <Grid Grid.Column="0" Margin="0,0,0,14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <HeaderedContentControl x:Name="ProfilePanel" Style="{StaticResource HudPanel}" Header="OPTIMIZATION PROFILE" Tag="CTRL+ALT+M">
                                <UniformGrid Columns="2" Margin="-3">
                                    <RadioButton x:Name="Prof0" Style="{StaticResource ProfileCard}" Tag="0" Click="Profile_Click">
                                        <StackPanel>
                                            <TextBlock Text="QUICK" FontFamily="Bahnschrift SemiBold" FontSize="13"/>
                                            <TextBlock Text="Trim + light cache" Style="{StaticResource T.Cap}"/>
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton x:Name="Prof1" Style="{StaticResource ProfileCard}" Tag="1" Click="Profile_Click">
                                        <StackPanel>
                                            <TextBlock Text="BALANCED" FontFamily="Bahnschrift SemiBold" FontSize="13"/>
                                            <TextBlock Text="+ standby + combine" Style="{StaticResource T.Cap}"/>
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton x:Name="Prof2" Style="{StaticResource ProfileCard}" Tag="2" Click="Profile_Click">
                                        <StackPanel>
                                            <TextBlock Text="DEEP" FontFamily="Bahnschrift SemiBold" FontSize="13"/>
                                            <TextBlock Text="Full system purge" Style="{StaticResource T.Cap}"/>
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton x:Name="Prof3" Style="{StaticResource ProfileCard}" Tag="3" Click="Profile_Click">
                                        <StackPanel>
                                            <TextBlock Text="CUSTOM" FontFamily="Bahnschrift SemiBold" FontSize="13"/>
                                            <TextBlock Text="Your rules (Settings)" Style="{StaticResource T.Cap}"/>
                                        </StackPanel>
                                    </RadioButton>
                                </UniformGrid>
                            </HeaderedContentControl>

                            <HeaderedContentControl x:Name="ShieldPanel" Grid.Row="1" Margin="0,14,0,0" Style="{StaticResource HudPanel}" Header="GAME SHIELD">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="74"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="64" Height="70" HorizontalAlignment="Left">
                                            <Ellipse x:Name="ShieldPulse" Width="64" Height="64" Stroke="{StaticResource B.Cyan}" StrokeThickness="1.5" Opacity="0" RenderTransformOrigin="0.5,0.5">
                                                <Ellipse.RenderTransform><ScaleTransform x:Name="ShieldPulseS"/></Ellipse.RenderTransform>
                                            </Ellipse>
                                            <Ellipse Width="70" Height="70" Fill="{StaticResource B.GlowCyan}" x:Name="ShieldGlow" Opacity="0.3"/>
                                            <Path x:Name="ShieldIcon" Data="{StaticResource G.Shield}" Width="36" Height="42" Stretch="Uniform" Fill="#2200E5FF" Stroke="{StaticResource B.Dim}" StrokeThickness="1.5"/>
                                            <Path x:Name="ShieldPad" Data="{StaticResource G.Pad}" Width="18" Height="14" Stretch="Uniform" Fill="{StaticResource B.Dim}" Margin="0,0,0,2"/>
                                        </Grid>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock x:Name="ShieldState" Text="STANDBY" FontFamily="Bahnschrift SemiBold" FontSize="16" Foreground="{StaticResource B.Muted}"/>
                                            <TextBlock x:Name="ShieldGame" Text="No game detected" FontSize="12.5" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock x:Name="ShieldDetail" Grid.Row="1" Margin="0,10,0,0" Style="{StaticResource T.Sub}" FontSize="11.5"
                                               Text="Watching game libraries, known titles and fullscreen apps. When a game runs, its processes, overlays and anti-cheat are never trimmed."/>
                                    <CheckBox x:Name="IncludeOnce" Grid.Row="2" Style="{StaticResource Switch}" FontSize="12" Content="Include game in next purge" Tag="One-time override"/>
                                </Grid>
                            </HeaderedContentControl>
                        </Grid>

                        <!-- center: reactor gauge -->
                        <Grid Grid.Column="1" Margin="14,0,14,14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Viewbox x:Name="GaugeBox" Stretch="Uniform" Margin="0,0,0,6">
                                <Grid x:Name="Gauge" Width="420" Height="420">
                                    <Ellipse x:Name="GaugeGlow" CacheMode="BitmapCache" Width="420" Height="420" Fill="{StaticResource B.GlowCyan}" Opacity="0.55"/>
                                    <Ellipse x:Name="Shock1" Width="300" Height="300" Stroke="{StaticResource B.Cyan}" StrokeThickness="3" Opacity="0" RenderTransformOrigin="0.5,0.5">
                                        <Ellipse.RenderTransform><ScaleTransform/></Ellipse.RenderTransform>
                                    </Ellipse>
                                    <Ellipse x:Name="Shock2" Width="300" Height="300" Stroke="{StaticResource B.Magenta}" StrokeThickness="2" Opacity="0" RenderTransformOrigin="0.5,0.5">
                                        <Ellipse.RenderTransform><ScaleTransform/></Ellipse.RenderTransform>
                                    </Ellipse>
                                    <Ellipse x:Name="PulseRing" Width="320" Height="320" Stroke="#8800E5FF" StrokeThickness="1" Opacity="0" RenderTransformOrigin="0.5,0.5">
                                        <Ellipse.RenderTransform><ScaleTransform x:Name="PulseS"/></Ellipse.RenderTransform>
                                    </Ellipse>
                                    <Ellipse Width="408" Height="408" Stroke="#4400E5FF" StrokeThickness="1" StrokeDashArray="1 5" RenderTransformOrigin="0.5,0.5">
                                        <Ellipse.RenderTransform><RotateTransform x:Name="RotOuter"/></Ellipse.RenderTransform>
                                    </Ellipse>
                                    <Grid Width="392" Height="392" RenderTransformOrigin="0.5,0.5">
                                        <Grid.RenderTransform><RotateTransform x:Name="RotSegs"/></Grid.RenderTransform>
                                        <ui:Arc StartAngle="10" Sweep="70" Thickness="2" Stroke="#9900E5FF"/>
                                        <ui:Arc StartAngle="190" Sweep="45" Thickness="2" Stroke="#99FF2BD6"/>
                                        <ui:Arc StartAngle="250" Sweep="12" Thickness="2" Stroke="#66FFFFFF"/>
                                    </Grid>
                                    <ui:TickRing Width="364" Height="364" CacheMode="BitmapCache" RenderTransformOrigin="0.5,0.5">
                                        <ui:TickRing.RenderTransform><RotateTransform x:Name="RotTicks"/></ui:TickRing.RenderTransform>
                                    </ui:TickRing>
                                    <ui:Arc Width="330" Height="330" StartAngle="-135" Sweep="270" Thickness="14" Stroke="#12FFFFFF"/>
                                    <ui:Arc x:Name="ValueArc" Width="330" Height="330" StartAngle="-135" Sweep="0" Thickness="14"/>
                                    <ui:Arc Width="292" Height="292" StartAngle="-135" Sweep="270" Thickness="3" Stroke="#0CFFFFFF"/>
                                    <ui:Arc x:Name="StandbyArc" Width="292" Height="292" StartAngle="-135" Sweep="0" Thickness="3" Stroke="#CC966EFF"/>
                                    <ui:Arc Width="262" Height="262" StartAngle="0" Sweep="80" Thickness="2" Opacity="0.6" RenderTransformOrigin="0.5,0.5">
                                        <ui:Arc.Stroke>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#0000E5FF" Offset="0"/>
                                                <GradientStop Color="#FF00E5FF" Offset="1"/>
                                            </LinearGradientBrush>
                                        </ui:Arc.Stroke>
                                        <ui:Arc.RenderTransform><RotateTransform x:Name="RotScanner"/></ui:Arc.RenderTransform>
                                    </ui:Arc>
                                    <Grid x:Name="ScanFast" Width="262" Height="262" Opacity="0" RenderTransformOrigin="0.5,0.5">
                                        <Grid.RenderTransform><RotateTransform x:Name="RotScanFast"/></Grid.RenderTransform>
                                        <ui:Arc StartAngle="0" Sweep="120" Thickness="4" Stroke="{StaticResource B.Accent}"/>
                                        <ui:Arc StartAngle="180" Sweep="120" Thickness="4" Stroke="{StaticResource B.Accent}"/>
                                    </Grid>
                                    <Ellipse Width="238" Height="238" Stroke="#2600E5FF" StrokeThickness="1">
                                        <Ellipse.Fill>
                                            <RadialGradientBrush>
                                                <GradientStop Color="#FF0D1A33" Offset="0"/>
                                                <GradientStop Color="#FF070D1C" Offset="0.85"/>
                                                <GradientStop Color="#FF0A1528" Offset="1"/>
                                            </RadialGradientBrush>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,6">
                                        <TextBlock x:Name="CoreLabel" Text="MEMORY LOAD" FontSize="12" Foreground="{StaticResource B.Muted}" HorizontalAlignment="Center"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,-4,0,-6">
                                            <ui:AnimatedNumber x:Name="LoadText" FontFamily="Bahnschrift Light" FontSize="84" Format="0" Duration="900"/>
                                            <TextBlock Text="%" FontSize="26" Foreground="{StaticResource B.Muted}" VerticalAlignment="Top" Margin="2,22,0,0"/>
                                        </StackPanel>
                                        <TextBlock x:Name="UsedText" Text="— / — GB" FontSize="15" HorizontalAlignment="Center" Foreground="#FFB7C7E3"/>
                                        <Border x:Name="LoadStateChip" CornerRadius="9" Padding="10,2" Margin="0,9,0,0" HorizontalAlignment="Center" BorderThickness="1" BorderBrush="#5500FFA3" Background="#1400FFA3">
                                            <TextBlock x:Name="LoadState" Text="NOMINAL" FontSize="10.5" FontFamily="Bahnschrift SemiBold" Foreground="{StaticResource B.Green}"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="0" FontSize="11" Foreground="{StaticResource B.Dim}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="92,0,0,80"/>
                                    <TextBlock Text="100" FontSize="11" Foreground="{StaticResource B.Dim}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,84,80"/>
                                </Grid>
                            </Viewbox>
                            <StackPanel Grid.Row="1" HorizontalAlignment="Center">
                                <Button x:Name="PurgeBtn" Style="{StaticResource PurgeButton}" Content="PURGE MEMORY" Tag="Balanced profile · Game Shield aware" Click="Purge_Click"/>
                                <Grid x:Name="ResultPanel" Height="46" Opacity="0" Margin="0,8,0,0">
                                    <Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>
                                    <StackPanel HorizontalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="▲" FontSize="13" Foreground="{StaticResource B.Green}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <ui:AnimatedNumber x:Name="FreedText" FontSize="22" FontFamily="Bahnschrift SemiBold" Foreground="{StaticResource B.Green}" Format="0" Suffix=" MB" Duration="1400"/>
                                            <TextBlock Text="RECLAIMED" FontSize="12" Foreground="{StaticResource B.Muted}" VerticalAlignment="Center" Margin="10,3,0,0"/>
                                        </StackPanel>
                                        <TextBlock x:Name="ResultDetail" FontSize="11" Foreground="{StaticResource B.Muted}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <!-- right column: telemetry -->
                        <HeaderedContentControl x:Name="TelemetryPanel" Grid.Column="2" Margin="0,0,0,14" Style="{StaticResource HudPanel}" Header="TELEMETRY" Tag="LIVE · 1 Hz">
                            <UniformGrid Columns="1" Margin="0,-3">
                                <ui:StatTile x:Name="StAvail" Label="AVAILABLE" Accent="{StaticResource B.Green}"/>
                                <ui:StatTile x:Name="StStandby" Label="STANDBY CACHE" Accent="{StaticResource B.Violet}"/>
                                <ui:StatTile x:Name="StModified" Label="MODIFIED (DIRTY)" Accent="{StaticResource B.Amber}"/>
                                <ui:StatTile x:Name="StFree" Label="FREE + ZEROED" Accent="{StaticResource B.Cyan}"/>
                                <ui:StatTile x:Name="StCommit" Label="COMMIT CHARGE" Accent="{StaticResource B.Magenta}"/>
                                <ui:StatTile x:Name="StCpu" Label="CPU LOAD" Accent="{StaticResource B.Accent}"/>
                            </UniformGrid>
                        </HeaderedContentControl>

                        <!-- bottom row -->
                        <HeaderedContentControl x:Name="ChartPanel" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,14,0" Style="{StaticResource HudPanel}" Header="MEMORY TIMELINE" Tag="120 s">
                            <Grid>
                                <ui:HistoryChart x:Name="Chart"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-30,0,0">
                                    <Rectangle Width="10" Height="3" Fill="{StaticResource B.Cyan}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="LOAD" FontSize="10" Foreground="{StaticResource B.Muted}" Margin="0,0,14,0"/>
                                    <Rectangle Width="10" Height="3" Fill="{StaticResource B.Violet}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="STANDBY" FontSize="10" Foreground="{StaticResource B.Muted}" Margin="0,0,14,0"/>
                                    <Rectangle Width="10" Height="1" Fill="{StaticResource B.Red}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="AUTO THRESHOLD" FontSize="10" Foreground="{StaticResource B.Muted}" Margin="0,0,70,0"/>
                                </StackPanel>
                            </Grid>
                        </HeaderedContentControl>

                        <HeaderedContentControl x:Name="LogPanel" Grid.Row="1" Grid.Column="2" Style="{StaticResource HudPanel}" Header="EVENT LOG">
                            <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,-8,0" Padding="0,0,8,0">
                                <ItemsControl x:Name="LogList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,1,0,3">
                                                <Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="40"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.Triggers>
                                                    <EventTrigger RoutedEvent="Loaded">
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.35"/>
                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="-14" To="0" Duration="0:0:0.35">
                                                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </EventTrigger>
                                                </Grid.Triggers>
                                                <TextBlock Text="{Binding Tag}" Foreground="{Binding TagBrush}" FontFamily="Consolas" FontSize="10.5" FontWeight="Bold" Margin="0,1,0,0"/>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Message}" FontSize="11.5" TextWrapping="Wrap" Foreground="#FFC9D6EC"/>
                                                    <TextBlock Text="{Binding Time}" FontFamily="Consolas" FontSize="9.5" Foreground="{StaticResource B.Dim}"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </HeaderedContentControl>
                    </Grid>

                    <!-- ================= PROCESSES ================= -->
                    <Grid x:Name="PageProc" Margin="24,20,24,16" Visibility="Collapsed">
                        <Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                                <StackPanel Margin="18,0,0,0">
                                    <TextBlock x:Name="PcTotal" Text="0" FontSize="22" FontFamily="Bahnschrift Light" HorizontalAlignment="Right"/>
                                    <TextBlock Text="PROCESSES" Style="{StaticResource T.Cap}" HorizontalAlignment="Right"/>
                                </StackPanel>
                                <StackPanel Margin="22,0,0,0">
                                    <TextBlock x:Name="PcShield" Text="0" FontSize="22" FontFamily="Bahnschrift Light" Foreground="{StaticResource B.Cyan}" HorizontalAlignment="Right"/>
                                    <TextBlock Text="SHIELDED" Style="{StaticResource T.Cap}" HorizontalAlignment="Right"/>
                                </StackPanel>
                                <StackPanel Margin="22,0,0,0">
                                    <TextBlock x:Name="PcWs" Text="0" FontSize="22" FontFamily="Bahnschrift Light" Foreground="{StaticResource B.Green}" HorizontalAlignment="Right"/>
                                    <TextBlock Text="TOTAL WORKING SET" Style="{StaticResource T.Cap}" HorizontalAlignment="Right"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="PROCESS MATRIX" Style="{StaticResource T.H1}"/>
                                <TextBlock Style="{StaticResource T.Sub}" Margin="0,4,0,0" Text="Live working-set map. Shield = never trim this app. Gamepad = treat it as a game. Bolt = trim just this process now."/>
                            </StackPanel>
                        </DockPanel>
                        <DockPanel Grid.Row="1" Margin="0,16,0,10">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <RadioButton Style="{StaticResource Seg}" GroupName="PFilter" Content="ALL" Tag="ALL" IsChecked="True" Click="ProcFilter_Click"/>
                                <RadioButton Style="{StaticResource Seg}" GroupName="PFilter" Content="SHIELDED" Tag="SHIELD" Click="ProcFilter_Click"/>
                                <RadioButton Style="{StaticResource Seg}" GroupName="PFilter" Content="TRIMMABLE" Tag="TRIM" Click="ProcFilter_Click"/>
                                <RadioButton Style="{StaticResource Seg}" GroupName="PFilter" Content="EXCLUDED" Tag="EXCL" Click="ProcFilter_Click" Margin="0"/>
                            </StackPanel>
                            <TextBox x:Name="ProcSearch" Style="{StaticResource Field}" Tag="Search processes…" Width="300" HorizontalAlignment="Left" TextChanged="ProcSearch_TextChanged"/>
                        </DockPanel>
                        <Border Grid.Row="2" CornerRadius="8" Background="{StaticResource B.PanelBg}" BorderBrush="{StaticResource B.PanelStroke}" BorderThickness="1" Padding="8,6,4,8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="30"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid Margin="8,0,14,0" TextElement.FontSize="10.5" TextElement.Foreground="{StaticResource B.Dim}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="190"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="104"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="1" Text="PROCESS" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="PID" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="WORKING SET  ▼" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="4" Text="PRIVATE" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="5" Text="STATUS" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="6" Text="ACTIONS" VerticalAlignment="Center"/>
                                </Grid>
                                <ListBox x:Name="ProcList" Grid.Row="1" Background="Transparent" Foreground="{StaticResource B.Text}" BorderThickness="0" ItemContainerStyle="{StaticResource ProcRow}"
                                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Height="42">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="40"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="70"/>
                                                    <ColumnDefinition Width="190"/>
                                                    <ColumnDefinition Width="90"/>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="104"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="28" Height="28" CornerRadius="7" Background="{Binding AvatarBrush}" HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding Initial}" FontFamily="Bahnschrift SemiBold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                                    <TextBlock Text="{Binding DisplayName}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Path}" FontSize="10" Foreground="{StaticResource B.Dim}" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding Pid}" FontFamily="Consolas" FontSize="11.5" Foreground="{StaticResource B.Muted}" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Grid Width="110" Height="4" Margin="0,0,10,0">
                                                        <Border CornerRadius="2" Background="#14FFFFFF"/>
                                                        <Border CornerRadius="2" Background="{StaticResource B.Accent}" Width="{Binding BarWidth}" HorizontalAlignment="Left"/>
                                                    </Grid>
                                                    <TextBlock Text="{Binding WsText}" FontSize="12"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="4" Text="{Binding PrivText}" FontSize="12" Foreground="{StaticResource B.Muted}" VerticalAlignment="Center"/>
                                                <Border Grid.Column="5" CornerRadius="9" BorderThickness="1" BorderBrush="{Binding StatusBrush}" Padding="8,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Status}" Foreground="{Binding StatusBrush}" FontSize="9.5" FontFamily="Bahnschrift SemiBold"/>
                                                </Border>
                                                <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <ToggleButton Style="{StaticResource IconToggle}" Tag="{StaticResource G.Shield}" IsChecked="{Binding IsExcluded, Mode=TwoWay}" Click="RowExclude_Click" ToolTip="Never trim this process"/>
                                                    <ToggleButton Style="{StaticResource IconToggle}" Tag="{StaticResource G.Pad}" IsChecked="{Binding IsCustomGame, Mode=TwoWay}" Click="RowGame_Click" ToolTip="Treat as a game (shield it)"/>
                                                    <Button Style="{StaticResource IconBtn}" Tag="{StaticResource G.Bolt}" Click="RowTrim_Click" ToolTip="Trim this process now"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ================= AUTOMATION ================= -->
                    <ScrollViewer x:Name="PageAuto" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <ScrollViewer.RenderTransform><TranslateTransform/></ScrollViewer.RenderTransform>
                        <StackPanel Margin="24,20,24,24">
                            <TextBlock Text="AUTOMATION" Style="{StaticResource T.H1}"/>
                            <TextBlock Style="{StaticResource T.Sub}" Margin="0,4,0,18" Text="Let Quanta purge on its own. Automatic purges use your selected profile and always respect Game Shield."/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <HeaderedContentControl Style="{StaticResource HudPanel}" Header="THRESHOLD TRIGGER" Margin="0,0,0,16">
                                        <StackPanel>
                                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding AutoCleanEnabled}" Content="Purge automatically under memory pressure" Tag="Fires when load crosses the threshold, with a 2-minute cooldown."/>
                                            <DockPanel Margin="0,10,0,0">
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Value, ElementName=ThreshSlider, StringFormat={}{0:0}%}" FontSize="20" FontFamily="Bahnschrift Light" Foreground="{StaticResource B.Cyan}" Width="60" TextAlignment="Right"/>
                                                <TextBlock Text="Trigger at load" Foreground="{StaticResource B.Muted}" VerticalAlignment="Center"/>
                                            </DockPanel>
                                            <Slider x:Name="ThreshSlider" Minimum="50" Maximum="97" Value="{Binding AutoThreshold}" SmallChange="1" LargeChange="5"/>
                                        </StackPanel>
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Style="{StaticResource HudPanel}" Header="GAMING BEHAVIOUR" Margin="0,0,0,16">
                                        <StackPanel>
                                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding PauseAutoWhileGaming}" Content="Pause all automation while a game runs" Tag="Off: automation still runs, but the game stays shielded. On: nothing runs until the game closes."/>
                                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding PauseVisualsWhileGaming}" Content="Freeze Quanta's visuals while gaming" Tag="Stops all animation (0% GPU) while a game runs and Quanta isn't focused."/>
                                        </StackPanel>
                                    </HeaderedContentControl>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <HeaderedContentControl Style="{StaticResource HudPanel}" Header="SCHEDULED PURGE" Margin="0,0,0,16">
                                        <StackPanel>
                                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding IntervalEnabled}" Content="Purge on a fixed interval" Tag="The timer restarts after every purge, manual ones included."/>
                                            <DockPanel Margin="0,10,0,0">
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Value, ElementName=IntervalSlider, StringFormat={}{0:0} min}" FontSize="20" FontFamily="Bahnschrift Light" Foreground="{StaticResource B.Cyan}" Width="90" TextAlignment="Right"/>
                                                <TextBlock Text="Every" Foreground="{StaticResource B.Muted}" VerticalAlignment="Center"/>
                                            </DockPanel>
                                            <Slider x:Name="IntervalSlider" Minimum="5" Maximum="240" Value="{Binding IntervalMinutes}" SmallChange="5" LargeChange="15" TickFrequency="5" IsSnapToTickEnabled="True"/>
                                        </StackPanel>
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Style="{StaticResource HudPanel}" Header="HOTKEY &amp; ALERTS" Margin="0,0,0,16">
                                        <StackPanel>
                                            <CheckBox x:Name="HotkeyBox" Style="{StaticResource Switch}" IsChecked="{Binding HotkeyEnabled}" Content="Global hotkey  ·  Ctrl + Alt + M" Tag="Runs the selected profile from anywhere, even mid-game."/>
                                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Notifications}" Content="Tray notifications" Tag="Shows a short summary after background purges."/>
                                        </StackPanel>
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Style="{StaticResource HudPanel}" Header="LIFETIME">
                                        <UniformGrid Columns="2">
                                            <StackPanel>
                                                <TextBlock x:Name="LifeFreed" Text="0 MB" FontSize="28" FontFamily="Bahnschrift Light" Foreground="{StaticResource B.Green}"/>
                                                <TextBlock Text="TOTAL RECLAIMED" Style="{StaticResource T.Cap}"/>
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock x:Name="LifeCleans" Text="0" FontSize="28" FontFamily="Bahnschrift Light" Foreground="{StaticResource B.Cyan}"/>
                                                <TextBlock Text="PURGES RUN" Style="{StaticResource T.Cap}"/>
                                            </StackPanel>
                                        </UniformGrid>
                                    </HeaderedContentControl>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ================= SETTINGS ================= -->
                    <ScrollViewer x:Name="PageSet" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <ScrollViewer.RenderTransform><TranslateTransform/></ScrollViewer.RenderTransform>
                        <StackPanel Margin="24,20,24,24">
                            <TextBlock Text="SETTINGS" Style="{StaticResource T.H1}"/>
                            <TextBlock Style="{StaticResource T.Sub}" Margin="0,4,0,18" Text="Tune the engine, the visuals and exactly what Game Shield protects."/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <HeaderedContentControl Style="{StaticResource HudPanel}" Header="GAME SHIELD" Margin="0,0,0,16">
                                        <StackPanel>
                                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding GameShieldEnabled}" Content="Game Shield" Tag="Protect running games: the game itself, its child processes, files in its install folder, overlays and anti-cheat."/>
                                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding IncludeGameProcesses}" Content="Always include game processes" Tag="Leave off unless you want the game's own memory trimmed too. The dashboard has a one-time version of this."/>
                                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding AllowSystemWideWhileGaming}" Content="Allow system-wide cache purges while gaming" Tag="Standby / file-cache purges can evict the game's cached assets and cause hitching. When off, they drop to the low-priority-only purge."/>
                                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding DetectFullscreen}" Content="Treat fullscreen apps as games" Tag="Catches titles not in any library. Browsers, video players and similar apps are ignored."/>
                                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding ProtectForeground}" Content="Never trim the focused app" Tag="Whatever window you're using stays fully in RAM."/>
                                        </StackPanel>
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Style="{StaticResource HudPanel}" Header="GAME LIST" Margin="0,0,0,16">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource T.Sub}" FontSize="11.5" Text="Executables that are always treated as games, on top of auto-detection."/>
                                            <DockPanel Margin="0,10,0,10">
                                                <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="ADD" Margin="8,0,0,0" Click="AddGame_Click"/>
                                                <TextBox x:Name="GameAddBox" Style="{StaticResource Field}" Tag="e.g. mygame.exe" KeyDown="GameAddBox_KeyDown"/>
                                            </DockPanel>
                                            <ItemsControl ItemsSource="{Binding CustomGames}">
                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate><Button Style="{StaticResource ChipBtn}" Tag="games" Click="Chip_Click"/></DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Style="{StaticResource HudPanel}" Header="EXCLUSIONS">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource T.Sub}" FontSize="11.5" Text="Executables that are never trimmed (DAWs, streaming software, VMs...)."/>
                                            <DockPanel Margin="0,10,0,10">
                                                <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="ADD" Margin="8,0,0,0" Click="AddExcl_Click"/>
                                                <TextBox x:Name="ExclAddBox" Style="{StaticResource Field}" Tag="e.g. obs64.exe" KeyDown="ExclAddBox_KeyDown"/>
                                            </DockPanel>
                                            <ItemsControl ItemsSource="{Binding Exclusions}">
                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate><Button Style="{StaticResource ChipBtn}" Tag="excl" Click="Chip_Click"/></DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </HeaderedContentControl>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <HeaderedContentControl Style="{StaticResource HudPanel}" Header="UPDATES" Tag="github.com/GPTmadeit/QuantaRAM" Margin="0,0,0,16">
                                        <StackPanel>
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button x:Name="InstallUpdBtn" Style="{StaticResource Ghost}" Content="INSTALL" Margin="0,0,8,0" Visibility="Collapsed" Click="InstallUpdate_Click"/>
                                                    <Button x:Name="CheckUpdBtn" Style="{StaticResource Ghost}" Content="CHECK NOW" Click="CheckUpdate_Click"/>
                                                </StackPanel>
                                                <StackPanel>
                                                    <TextBlock x:Name="UpdVersion" Text="Installed v1.0.0" FontSize="15" FontFamily="Bahnschrift SemiBold"/>
                                                    <TextBlock x:Name="UpdStatus" Text="Not checked yet" Style="{StaticResource T.Sub}" FontSize="11.5" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </DockPanel>
                                            <Grid x:Name="UpdProgressBox" Height="4" Margin="0,10,0,0" Visibility="Collapsed">
                                                <Border CornerRadius="2" Background="#18FFFFFF"/>
                                                <Border CornerRadius="2" Background="{StaticResource B.Accent}" RenderTransformOrigin="0,0.5">
                                                    <Border.RenderTransform><ScaleTransform x:Name="UpdProgressS" ScaleX="0"/></Border.RenderTransform>
                                                </Border>
                                            </Grid>
                                            <CheckBox Style="{StaticResource Switch}" Margin="0,10,0,4" IsChecked="{Binding AutoCheckUpdates}" Content="Check for updates automatically" Tag="At startup and every 6 hours, using GitHub Releases."/>
                                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding AutoInstallUpdates}" Content="Install updates automatically" Tag="Downloads, verifies (SHA-256) and restarts Quanta. Never while a game is running."/>
                                        </StackPanel>
                                    </HeaderedContentControl>                                    <HeaderedContentControl Style="{StaticResource HudPanel}" Header="VISUAL ENGINE" Margin="0,0,0,16">
                                        <StackPanel>
                                            <TextBlock Text="Animation" Foreground="{StaticResource B.Muted}" Margin="0,0,0,6"/>
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton x:Name="AnimFull" Style="{StaticResource Seg}" GroupName="Anim" Content="FULL" Tag="2" Click="Seg_Click"/>
                                                <RadioButton x:Name="AnimReduced" Style="{StaticResource Seg}" GroupName="Anim" Content="REDUCED" Tag="1" Click="Seg_Click"/>
                                                <RadioButton x:Name="AnimOff" Style="{StaticResource Seg}" GroupName="Anim" Content="OFF" Tag="0" Click="Seg_Click"/>
                                            </StackPanel>
                                            <TextBlock Text="Frame cap" Foreground="{StaticResource B.Muted}" Margin="0,14,0,6"/>
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton x:Name="Fps24" Style="{StaticResource Seg}" GroupName="Fps" Content="24 FPS" Tag="24" Click="Seg_Click"/>
                                                <RadioButton x:Name="Fps30" Style="{StaticResource Seg}" GroupName="Fps" Content="30 FPS" Tag="30" Click="Seg_Click"/>
                                                <RadioButton x:Name="Fps60" Style="{StaticResource Seg}" GroupName="Fps" Content="60 FPS" Tag="60" Click="Seg_Click"/>
                                            </StackPanel>
                                            <TextBlock Text="Renderer" Foreground="{StaticResource B.Muted}" Margin="0,14,0,6"/>
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton x:Name="RenderGpu" Style="{StaticResource Seg}" GroupName="Render" Content="GPU · LITE" Tag="gpu" Click="Seg_Click"/>
                                                <RadioButton x:Name="RenderCpu" Style="{StaticResource Seg}" GroupName="Render" Content="CPU ONLY · 0% GPU" Tag="cpu" Click="Seg_Click"/>
                                            </StackPanel>
                                            <TextBlock Style="{StaticResource T.Sub}" FontSize="11" Margin="0,10,0,0" Text="All animation is frame-capped and stops completely when Quanta is minimized or in the tray. CPU-only takes the GPU out of the picture."/>
                                        </StackPanel>
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Style="{StaticResource HudPanel}" Header="CUSTOM PROFILE" Margin="0,0,0,16">
                                        <StackPanel>
                                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding CTrim}" Content="Trim process working sets" Tag="Pages idle memory out of every non-protected process."/>
                                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding CLowStandby}" Content="Purge low-priority standby" Tag="Drops only the least useful cached pages. Safe while gaming."/>
                                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding CStandby}" Content="Purge full standby list" Tag="Turns all cached memory into free memory. Admin required."/>
                                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding CModified}" Content="Flush modified page list" Tag="Writes dirty pages to disk so they can be reused. Admin required."/>
                                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding CFileCache}" Content="Flush system file cache" Tag="Empties the kernel file-cache working set. Admin required."/>
                                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding CCombine}" Content="Combine identical pages" Tag="Deduplicates identical memory pages. Never evicts data. Admin required."/>
                                        </StackPanel>
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Style="{StaticResource HudPanel}" Header="SYSTEM">
                                        <StackPanel>
                                            <CheckBox x:Name="StartupBox" Style="{StaticResource Switch}" IsChecked="{Binding StartWithWindows}" Click="Startup_Click" Content="Start with Windows" Tag="Starts in the tray. When enabled from an elevated session, it starts with admin rights and no UAC prompt."/>
                                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding StartMinimized}" Content="Start minimized to tray"/>
                                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding MinimizeToTray}" Content="Close button sends Quanta to the tray" Tag="Automation and the hotkey keep running in the background."/>
                                        </StackPanel>
                                    </HeaderedContentControl>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- ================= status bar ================= -->
            <Grid Grid.Row="2">
                <Border Background="#C0040710" BorderBrush="{StaticResource B.Stroke}" BorderThickness="0,1,0,0"/>
                <StackPanel Orientation="Horizontal" Margin="18,0" VerticalAlignment="Center" TextElement.FontSize="10.5" TextElement.Foreground="{StaticResource B.Muted}">
                    <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{StaticResource B.Green}" Margin="0,0,8,0"/>
                    <TextBlock Text="CORE ONLINE" Foreground="{StaticResource B.Green}" FontFamily="Bahnschrift SemiBold"/>
                    <TextBlock Text="  │  " Foreground="{StaticResource B.Stroke}"/>
                    <TextBlock x:Name="StatusShield" Text="SHIELD · STANDBY"/>
                    <TextBlock Text="  │  " Foreground="{StaticResource B.Stroke}"/>
                    <TextBlock x:Name="StatusAuto" Text="AUTO · OFF"/>
                    <TextBlock Text="  │  " Foreground="{StaticResource B.Stroke}"/>
                    <TextBlock x:Name="StatusLast" Text="LAST PURGE · —"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="18,0" VerticalAlignment="Center" TextElement.FontSize="10.5" TextElement.Foreground="{StaticResource B.Muted}">
                    <TextBlock x:Name="StatusPaused" Text="VISUALS PAUSED · GAME ACTIVE    " Foreground="{StaticResource B.Amber}" Visibility="Collapsed"/>
                    <TextBlock x:Name="StatusRender" Text="RENDER · GPU-LITE 30 FPS"/>
                    <TextBlock Text="  │  " Foreground="{StaticResource B.Stroke}"/>
                    <TextBlock x:Name="StatusHotkey" Text="HOTKEY · CTRL+ALT+M"/>
                    <TextBlock Text="_" x:Name="BlinkCursor" Foreground="{StaticResource B.Cyan}" Margin="4,0,0,0"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
