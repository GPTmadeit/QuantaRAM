<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================= palette ================= -->
    <Color x:Key="C.Cyan">#FF00E5FF</Color>
    <Color x:Key="C.Magenta">#FFFF2BD6</Color>
    <Color x:Key="C.Violet">#FF966EFF</Color>

    <SolidColorBrush x:Key="B.Bg0" Color="#FF04060C"/>
    <SolidColorBrush x:Key="B.Stroke" Color="#FF16243D"/>
    <SolidColorBrush x:Key="B.Cyan" Color="#FF00E5FF"/>
    <SolidColorBrush x:Key="B.Magenta" Color="#FFFF2BD6"/>
    <SolidColorBrush x:Key="B.Violet" Color="#FF966EFF"/>
    <SolidColorBrush x:Key="B.Green" Color="#FF00FFA3"/>
    <SolidColorBrush x:Key="B.Amber" Color="#FFFFB547"/>
    <SolidColorBrush x:Key="B.Red" Color="#FFFF3D6E"/>
    <SolidColorBrush x:Key="B.Text" Color="#FFE6F1FF"/>
    <SolidColorBrush x:Key="B.Muted" Color="#FF6F84A8"/>
    <SolidColorBrush x:Key="B.Dim" Color="#FF4A5B7C"/>

    <LinearGradientBrush x:Key="B.Accent" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FF00E5FF" Offset="0"/>
        <GradientStop Color="#FF966EFF" Offset="0.55"/>
        <GradientStop Color="#FFFF2BD6" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="B.AccentV" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF00E5FF" Offset="0"/>
        <GradientStop Color="#FFFF2BD6" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="B.PanelBg" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#D90B1324" Offset="0"/>
        <GradientStop Color="#CC070C18" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="B.PanelStroke" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#5500E5FF" Offset="0"/>
        <GradientStop Color="#12FFFFFF" Offset="0.4"/>
        <GradientStop Color="#12FFFFFF" Offset="0.7"/>
        <GradientStop Color="#40FF2BD6" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="B.Sel" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#3000E5FF" Offset="0"/>
        <GradientStop Color="#0A966EFF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="B.Shine" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#00FFFFFF" Offset="0"/>
        <GradientStop Color="#55FFFFFF" Offset="0.5"/>
        <GradientStop Color="#00FFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <RadialGradientBrush x:Key="B.GlowCyan">
        <GradientStop Color="#6600E5FF" Offset="0"/>
        <GradientStop Color="#1A00E5FF" Offset="0.55"/>
        <GradientStop Color="#0000E5FF" Offset="1"/>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="B.GlowMagenta">
        <GradientStop Color="#55FF2BD6" Offset="0"/>
        <GradientStop Color="#00FF2BD6" Offset="1"/>
    </RadialGradientBrush>

    <DrawingBrush x:Key="B.GridTile" TileMode="Tile" Viewport="0,0,44,44" ViewportUnits="Absolute" Viewbox="0,0,44,44" ViewboxUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#01000000" Geometry="M0,0 L44,0 44,44 0,44Z"/>
                <GeometryDrawing Geometry="M0,0.5 L44,0.5 M0.5,0 L0.5,44">
                    <GeometryDrawing.Pen><Pen Brush="#1000E5FF" Thickness="1"/></GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Brush="#3500E5FF">
                    <GeometryDrawing.Geometry><EllipseGeometry Center="0.5,0.5" RadiusX="1.3" RadiusY="1.3"/></GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- ================= icons (24x24) ================= -->
    <Geometry x:Key="G.Dash">M3,13H11V3H3V13Z M3,21H11V15H3V21Z M13,21H21V11H13V21Z M13,3V9H21V3H13Z</Geometry>
    <Geometry x:Key="G.Proc">M9,3V5H7A2,2 0 0,0 5,7V9H3V11H5V13H3V15H5V17A2,2 0 0,0 7,19H9V21H11V19H13V21H15V19H17A2,2 0 0,0 19,17V15H21V13H19V11H21V9H19V7A2,2 0 0,0 17,5H15V3H13V5H11V3M7,7H17V17H7M9,9V15H15V9Z</Geometry>
    <Geometry x:Key="G.Bolt">M7,2V13H10V22L17,10H13L17,2H7Z</Geometry>
    <Geometry x:Key="G.Tune">M3,17V19H9V17H3M3,5V7H13V5H3M13,21V19H21V17H13V15H11V21H13M7,9V11H3V13H7V15H9V9H7M21,13V11H11V13H21M15,9H17V7H21V5H17V3H15V9Z</Geometry>
    <Geometry x:Key="G.Shield">M12,1L3,5V11C3,16.55 6.84,21.74 12,23C17.16,21.74 21,16.55 21,11V5L12,1Z</Geometry>
    <Geometry x:Key="G.Pad">M21,6H3A2,2 0 0,0 1,8V16A2,2 0 0,0 3,18H21A2,2 0 0,0 23,16V8A2,2 0 0,0 21,6M11,13H8V16H6V13H3V11H6V8H8V11H11V13M15.5,15A1.5,1.5 0 0,1 14,13.5A1.5,1.5 0 0,1 15.5,12A1.5,1.5 0 0,1 17,13.5A1.5,1.5 0 0,1 15.5,15M19.5,12A1.5,1.5 0 0,1 18,10.5A1.5,1.5 0 0,1 19.5,9A1.5,1.5 0 0,1 21,10.5A1.5,1.5 0 0,1 19.5,12Z</Geometry>
    <Geometry x:Key="G.Hex">M12,1 L21.5,6.5 L21.5,17.5 L12,23 L2.5,17.5 L2.5,6.5 Z</Geometry>
    <Geometry x:Key="G.Min">M0,5 L10,5</Geometry>
    <Geometry x:Key="G.Max">M0.5,0.5 L9.5,0.5 L9.5,9.5 L0.5,9.5 Z</Geometry>
    <Geometry x:Key="G.Close">M0,0 L10,10 M10,0 L0,10</Geometry>

    <!-- ================= text ================= -->
    <Style x:Key="T.H1" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Bahnschrift SemiBold"/>
        <Setter Property="FontSize" Value="26"/>
        <Setter Property="Foreground" Value="{StaticResource B.Text}"/>
    </Style>
    <Style x:Key="T.Sub" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{StaticResource B.Muted}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="T.Cap" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10.5"/>
        <Setter Property="Foreground" Value="{StaticResource B.Muted}"/>
    </Style>

    <!-- ================= HUD panel ================= -->
    <Style x:Key="HudPanel" TargetType="HeaderedContentControl">
        <Setter Property="Foreground" Value="{StaticResource B.Text}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="HeaderedContentControl">
                    <Grid>
                        <Grid CacheMode="BitmapCache">
                            <Border CornerRadius="8" Background="{StaticResource B.PanelBg}" BorderBrush="{StaticResource B.PanelStroke}" BorderThickness="1"/>
                            <Path Data="M0,14 L0,0 14,0" Stroke="{StaticResource B.Cyan}" StrokeThickness="2" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-1,-1,0,0"/>
                            <Path Data="M0,0 L14,0 14,14" Stroke="#6600E5FF" StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-1,-1,0"/>
                            <Path Data="M0,0 L0,14 14,14" Stroke="#66FF2BD6" StrokeThickness="2" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-1,0,0,-1"/>
                            <Path Data="M14,0 L14,14 0,14" Stroke="{StaticResource B.Magenta}" StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-1,-1"/>
                        </Grid>
                        <DockPanel Margin="16,12,16,14">
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                <Rectangle Width="3" Height="11" Fill="{StaticResource B.AccentV}" Margin="0,0,9,0" VerticalAlignment="Center"/>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" FontSize="10" Foreground="{StaticResource B.Dim}" VerticalAlignment="Center"/>
                                <ContentPresenter ContentSource="Header" VerticalAlignment="Center" TextElement.FontSize="11.5" TextElement.FontFamily="Bahnschrift SemiBold" TextElement.Foreground="#FFB7C7E3"/>
                            </DockPanel>
                            <ContentPresenter/>
                        </DockPanel>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= switch ================= -->
    <Style x:Key="Switch" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource B.Text}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,5"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                            <ContentPresenter/>
                            <TextBlock x:Name="Desc" Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" FontSize="11" Foreground="{StaticResource B.Muted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Grid Grid.Column="1" Width="42" Height="22" VerticalAlignment="Center">
                            <Border CornerRadius="11" Background="#FF121B2C" BorderBrush="#FF2A3B5A" BorderThickness="1"/>
                            <Border x:Name="Fill" CornerRadius="11" Opacity="0" Background="{StaticResource B.Accent}"/>
                            <Ellipse x:Name="Thumb" Width="16" Height="16" HorizontalAlignment="Left" Margin="3,0,0,0" Fill="#FF8FA3C7">
                                <Ellipse.RenderTransform><TranslateTransform/></Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="{x:Null}">
                            <Setter TargetName="Desc" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Thumb" Property="Fill" Value="White"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="20" Duration="0:0:0.25">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.4"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Fill" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="0" Duration="0:0:0.25">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.4"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Fill" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= slider ================= -->
    <Style x:Key="SliderFill" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Height="4" CornerRadius="2" Background="{StaticResource B.Accent}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SliderEmpty" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Slider">
        <Setter Property="IsMoveToPointEnabled" Value="True"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,8,0,4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Height="24" Background="Transparent">
                        <Border Height="4" CornerRadius="2" Background="#FF16213A" VerticalAlignment="Center"/>
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource SliderFill}" Command="Slider.DecreaseLarge"/></Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource SliderEmpty}" Command="Slider.IncreaseLarge"/></Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Grid Width="20" Height="20">
                                                <Ellipse x:Name="Halo" Fill="{StaticResource B.GlowCyan}" Margin="-6"/>
                                                <Ellipse Fill="#FF0A1222" Stroke="{StaticResource B.Cyan}" StrokeThickness="2"/>
                                                <Ellipse Width="6" Height="6" Fill="White"/>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Halo" Property="Margin" Value="-10"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= scrollbar ================= -->
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="6"/>
        <Setter Property="MinWidth" Value="6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="B" CornerRadius="3" Background="#FF22324F"/>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="B" Property="Background" Value="#FF00A6BD"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="Height" Value="0"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ================= text box ================= -->
    <Style x:Key="Field" TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource B.Text}"/>
        <Setter Property="CaretBrush" Value="{StaticResource B.Cyan}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource B.Cyan}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border x:Name="Bd" CornerRadius="6" Background="#0FFFFFFF" BorderBrush="#24FFFFFF" BorderThickness="1"/>
                        <TextBlock x:Name="Ph" Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Foreground="{StaticResource B.Dim}" Margin="12,0" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed"/>
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Ph" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource B.Cyan}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= buttons ================= -->
    <Style x:Key="Ghost" TargetType="Button">
        <Setter Property="Foreground" Value="#FFB7C7E3"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="FontFamily" Value="Bahnschrift SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="14,6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="5" Background="#0AFFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1" Padding="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform><ScaleTransform/></Border.RenderTransform>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource B.Cyan}"/>
                            <Setter TargetName="Bd" Property="Background" Value="#1A00E5FF"/>
                            <Setter Property="Foreground" Value="{StaticResource B.Cyan}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="RenderTransform">
                                <Setter.Value><ScaleTransform ScaleX="0.96" ScaleY="0.96"/></Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WinBtn" TargetType="Button">
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="44"/>
        <Setter Property="Foreground" Value="#FF8FA3C7"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent">
                        <Path Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.1" Width="10" Height="10" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#18FFFFFF"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="WinClose" TargetType="Button" BasedOn="{StaticResource WinBtn}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#FFE81F4F"/>
            </Trigger>
        </Style.Triggers>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent">
                        <Path Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.1" Width="10" Height="10" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#FFE81F4F"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NavBtn" TargetType="RadioButton">
        <Setter Property="Width" Value="54"/>
        <Setter Property="Height" Value="54"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
        <Setter Property="GroupName" Value="Nav"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="#FF5B6E92"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <Border x:Name="Hover" CornerRadius="12" Background="#14FFFFFF" Opacity="0"/>
                        <Border x:Name="Sel" CornerRadius="12" Background="{StaticResource B.Sel}" BorderBrush="#4400E5FF" BorderThickness="1" Opacity="0"/>
                        <Path Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Fill="{TemplateBinding Foreground}" Width="22" Height="22" Stretch="Uniform"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Hover" Property="Opacity" Value="1"/>
                            <Setter Property="Foreground" Value="#FFB7C7E3"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource B.Cyan}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard><DoubleAnimation Storyboard.TargetName="Sel" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.3"/></Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard><DoubleAnimation Storyboard.TargetName="Sel" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3"/></Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ProfileCard" TargetType="RadioButton">
        <Setter Property="Margin" Value="3"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="GroupName" Value="Profile"/>
        <Setter Property="Foreground" Value="{StaticResource B.Text}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid MinHeight="58">
                        <Border x:Name="Bg" CornerRadius="6" Background="#0AFFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1"/>
                        <Border x:Name="Sel" CornerRadius="6" Opacity="0" Background="{StaticResource B.Sel}" BorderBrush="{StaticResource B.Cyan}" BorderThickness="1"/>
                        <Rectangle x:Name="Bar" Width="3" HorizontalAlignment="Left" Margin="0,12" Fill="{StaticResource B.AccentV}" RenderTransformOrigin="0.5,0.5">
                            <Rectangle.RenderTransform><ScaleTransform ScaleY="0"/></Rectangle.RenderTransform>
                        </Rectangle>
                        <ContentPresenter Margin="13,8,8,8" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="BorderBrush" Value="#5500E5FF"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Sel" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.25"/>
                                        <DoubleAnimation Storyboard.TargetName="Bar" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.4">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Sel" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25"/>
                                        <DoubleAnimation Storyboard.TargetName="Bar" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Seg" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{StaticResource B.Muted}"/>
        <Setter Property="FontFamily" Value="Bahnschrift SemiBold"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" CornerRadius="5" Background="#0AFFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1" Padding="14,7" VerticalAlignment="Center">
                        <ContentPresenter HorizontalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#6600E5FF"/>
                            <Setter Property="Foreground" Value="{StaticResource B.Text}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource B.Sel}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource B.Cyan}"/>
                            <Setter Property="Foreground" Value="{StaticResource B.Cyan}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="IconToggle" TargetType="ToggleButton">
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Margin" Value="2,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="#FF4A5B7C"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" CornerRadius="6" Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
                        <Path Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Fill="{TemplateBinding Foreground}" Width="14" Height="14" Stretch="Uniform"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#14FFFFFF"/>
                            <Setter Property="Foreground" Value="#FFB7C7E3"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#88FFB547"/>
                            <Setter TargetName="Bd" Property="Background" Value="#22FFB547"/>
                            <Setter Property="Foreground" Value="{StaticResource B.Amber}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="IconBtn" TargetType="Button">
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Margin" Value="2,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="#FF4A5B7C"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="6" Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
                        <Path Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Fill="{TemplateBinding Foreground}" Width="14" Height="14" Stretch="Uniform"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#1A00E5FF"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#6600E5FF"/>
                            <Setter Property="Foreground" Value="{StaticResource B.Cyan}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ChipBtn" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,6,6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="12" Background="#1400E5FF" BorderBrush="#4400E5FF" BorderThickness="1" Padding="10,4,8,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding}" Foreground="{StaticResource B.Text}" FontSize="12"/>
                            <TextBlock x:Name="X" Text="  ✕" Foreground="{StaticResource B.Muted}" FontSize="11"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource B.Red}"/>
                            <Setter TargetName="X" Property="Foreground" Value="{StaticResource B.Red}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PurgeButton" TargetType="Button">
        <Setter Property="Width" Value="300"/>
        <Setter Property="Height" Value="62"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="R" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform><ScaleTransform/></Grid.RenderTransform>
                        <Border x:Name="Ring" CornerRadius="36" Margin="-6" BorderBrush="{StaticResource B.Accent}" BorderThickness="1" Opacity="0.4"/>
                        <Border x:Name="Glow" CornerRadius="40" Margin="-18,-14" Background="{StaticResource B.GlowCyan}" Opacity="0.35"/>
                        <Border CornerRadius="31" Background="#FF0A1428"/>
                        <Border CornerRadius="31" Background="{StaticResource B.Sel}"/>
                        <Grid>
                            <Grid.Clip><RectangleGeometry Rect="0,0,300,62" RadiusX="31" RadiusY="31"/></Grid.Clip>
                            <Rectangle x:Name="Shine" Width="90" HorizontalAlignment="Left" Fill="{StaticResource B.Shine}">
                                <Rectangle.RenderTransform><TranslateTransform X="-120"/></Rectangle.RenderTransform>
                            </Rectangle>
                        </Grid>
                        <Border CornerRadius="31" BorderBrush="{StaticResource B.Accent}" BorderThickness="1.5"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Data="{StaticResource G.Bolt}" Fill="{StaticResource B.Cyan}" Width="16" Height="22" Stretch="Uniform" Margin="0,0,12,0"/>
                            <StackPanel>
                                <ContentPresenter TextElement.FontFamily="Bahnschrift SemiBold" TextElement.FontSize="18"/>
                                <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" FontSize="10.5" Foreground="#FF8FA3C7"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="0.9" Duration="0:0:0.25"/>
                                        <DoubleAnimation Storyboard.TargetName="Shine" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="-120" To="340" Duration="0:0:0.75">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard><DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="0.35" Duration="0:0:0.4"/></Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="R" Property="RenderTransform">
                                <Setter.Value><ScaleTransform ScaleX="0.97" ScaleY="0.97"/></Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="R" Property="Opacity" Value="0.8"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{StaticResource B.Text}"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="#F20B1324" BorderBrush="#5500E5FF" BorderThickness="1" CornerRadius="5" Padding="10,6">
                        <ContentPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ProcRow" TargetType="ListBoxItem">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" CornerRadius="6" Background="Transparent" Margin="0,1" Padding="8,0">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#1000E5FF"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#1C00E5FF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
